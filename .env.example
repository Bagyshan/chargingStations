# ==========================================================================
# Конфигурация деплоя (docker-compose.prod.yaml).
# Скопируй в .env и подставь свои значения:  cp .env.example .env
# Файл .env в .gitignore — секреты в репозиторий не попадают.
# ==========================================================================

# Публичный адрес сервера — ДОМЕН для HTTPS (Let's Encrypt не выдаёт сертификат на голый IP).
# Используется для: Keycloak KC_HOSTNAME и issuer токенов, ссылок в письмах, callback O!Dengi.
SERVER_HOST=charging.example.com

# Схема публичных URL. http по умолчанию; ПОСЛЕ выпуска TLS-сертификата (nginx/init-letsencrypt.sh)
# выставить https — тогда issuer Keycloak и ссылки станут https. Внутри контейнеров трафик остаётся http.
PUBLIC_SCHEME=http

# Почта для Let's Encrypt (уведомления об истечении). Нужна для nginx/init-letsencrypt.sh.
LETSENCRYPT_EMAIL=you@example.com

# -------------------- Пароли баз данных (ОБЯЗАТЕЛЬНО сменить) --------------------
STATION_DB_PASSWORD=changeme
USER_DB_PASSWORD=changeme
PAYMENT_DB_PASSWORD=changeme
BOOKING_DB_PASSWORD=changeme
CONTRACTOR_DB_PASSWORD=changeme
SUPPORT_BOT_DB_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme
STEVE_DB_PASSWORD=changeme

# -------------------- Keycloak --------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Секрет клиента user-service в realm charging-stations.
# Должен совпадать со значением в импортируемом realm (keycloak-realm-config / setup-keycloak.py).
KEYCLOAK_CLIENT_SECRET=<сгенерируй-надёжный-секрет-клиента>

# -------------------- SteVe (OCPP веб-админка) --------------------
# Пароль веб-интерфейса SteVe (/steve/manager, логин: admin). Сменить обязательно!
STEVE_AUTH_PASSWORD=<надёжный-пароль-админки-steve>

# -------------------- Внутренний общий секрет сервисов --------------------
# Заголовок X-Internal-Token для внутренних endpoint'ов user-service (device-tokens),
# которые зовёт notification-service. Задать СИЛЬНЫЙ случайный (напр. `openssl rand -hex 32`).
# Пустое/незаданное значение блокирует внутренние endpoint'ы (push-токены недоступны).
INTERNAL_API_TOKEN=<сгенерируй: openssl rand -hex 32>

# -------------------- Почта (Gmail SMTP) — user/notification --------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_USERNAME=<gmail-адрес-отправителя>
EMAIL_PASSWORD=<gmail-app-password>

# -------------------- O!Dengi (dengi.kg) — payment-service --------------------
# По умолчанию sandbox. Для продакшна заменить на боевые SID/пароль/URL и DENGI_TEST=0.
# ВНИМАНИЕ: значения чувствительные, не коммитить.
DENGI_API_URL=https://mw-api-test.dengi.kg/api/json/json.php
DENGI_SID=<merchant-sid>
DENGI_PASSWORD=<пароль-O!Dengi>
DENGI_TEST=1

# Адрес OTLP-приёмника (gateway OTel Collector) на obs-VM. Формат host:4317.
OBSERVABILITY_OTLP_ENDPOINT=obs-vm:4317

# -------------------- Telegram-бот поддержки (support-bot-service) --------------------
# Токен бота из @BotFather (обязателен, иначе бот не запустит long polling).
TELEGRAM_BOT_TOKEN=<токен-из-BotFather>
# Куда форвардить жалобы: id личного чата, группы или канала поддержки.
# Для группы это отрицательное число (напр. -1001234567890). Как узнать — см.
# support-bot-service/README.md. Можно оставить пустым — тогда жалобы только пишутся в БД.
TELEGRAM_SUPPORT_CHAT_ID=
